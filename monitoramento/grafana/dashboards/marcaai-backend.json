    {
      "id": 8,
      "type": "timeseries",
      "title": "Chamadas à IA por resultado",
      "description": "Justificativa da triagem + relatório da fila. Recusada = bulkhead cheio; bloqueada = circuito aberto. As duas vão para o template.",
