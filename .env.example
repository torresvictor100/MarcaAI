# Banco de dados
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marcaai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Segurança (JWT assinado com par de chaves RSA, RS256 — ADR-010).
# Gerar os três segredos abaixo com: scripts/gerar-segredos.sh >> .env   (sem eles o backend não sobe)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Chave mestra AES (32 bytes, Base64) que cifra o CPF no banco (LGPD). Gerar uma vez por banco e nunca trocar
# num banco com dados: os CPFs já gravados ficariam ilegíveis.
MARCAAI_CRIPTO_CHAVE=
# Monitoramento (opcional, ADR-011): senha com que o Prometheus lê /actuator/prometheus e senha do admin do
# Grafana. Também geradas pelo scripts/gerar-segredos.sh. Subir com: docker compose --profile monitoramento up -d
MARCAAI_METRICAS_TOKEN=
GRAFANA_SENHA_ADMIN=
JWT_EXPIRATION_MS=3600000    # 1 hora

# IA (justificativa da fila — TriagemIAService)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Opcionais — relatório de sugestões da fila (ADR-008)
# ANTHROPIC_RELATORIO_TIMEOUT_MS=15000
# MARCAAI_RELATORIO_DIAS_PARA_ANTECIPAR=7
# MARCAAI_RELATORIO_DIAS_ESPERA_LONGA=30

# CORS (origem liberada para o frontend de teste em frontend/, ver ADR-006)
MARCAAI_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seed automático de demonstração (DemoDataSeeder) — roda a triagem real e agenda/atende alguns
# encaminhamentos da massa de dados (V015) na subida. true por padrão; use false fora de ambiente de demo.
MARCAAI_SEED_DEMO_AUTOMATICO=true

# Fuso horário do backend (JVM). Padrão: horário de Brasília; sem isso o container roda em UTC (3h à frente).
TZ=America/Sao_Paulo
